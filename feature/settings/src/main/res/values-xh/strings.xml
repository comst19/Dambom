    <string name="help_intro">Khuphela kuphela iividiyo zoluntu, ezingezizo ze- DRM onemvume yokugcina.</string>
    <string name="help_step_url_title">1. Fumana ngedilesi yewebhu</string>
    <string name="help_step_url_description">Namathisela idilesi yeqonga levidiyo kwi-Home, fumana iividiyo, kwaye ukhethe oko ufuna ukusigcina.</string>
    <string name="help_step_share_title">2. Yabelana ukusuka kwi- Chrome okanye X</string>
    <string name="help_step_share_description">Khetha i- Dambom kwimenyu yokwabelana yesinye isicelo, qinisekisa ikhonkco, kwaye uqale ukufumana iividiyo.</string>
    <string name="help_step_web_title">3. Khangela ngaphakathi kwesicelo</string>
    <string name="help_step_web_description">Vula iithebhu ezininzi zewebhu, dlala ividiyo ekhoyo kwiphepha lamanje, emva koko cofa ku-Detect video.</string>
    <string name="help_step_download_title">4. Lawula ukukhutshelwa</string>
    <string name="help_step_download_description">Jonga inkqubela yomqolo kwaye ume, qhubeka, rhoxisa, okanye uphinde uzame ukukhuphela nganye.</string>
    <string name="help_step_library_title">5. Bukela kwiLibrary</string>
    <string name="help_step_library_description">Xa ushiya ngelixa ividiyo yasendaweni egqityiweyo idlalwa kwiscreen esigcweleyo, ukudlala kuyaqhubeka kwi PiP kwizixhobo ezixhaswayo. Iividiyo ezinye ezikwi-inline, ezime, okanye ezingekho azingeni ngokuzenzekelayo, kwaye akukho nkonzo yokudlala ngemvelaphi enikeziweyo.</string>
    <string name="settings_shared_auto_download">Zikhuphele ngokuzenzekelayo izixhumanisi ezabelwana ngazo</string>
    <string name="settings_shared_auto_description">Khuphela kuphela izixhumanisi ezabelwana ngazo kumgangatho owukhethileyo. Khetha ividiyo kuqala xa kukho ezininzi ezifunyenweyo.</string>
