    <string name="help_step_url_description">Paste a video page address on Home, find videos, and choose what to save.</string>
    <string name="help_step_share_title">2. Share from Chrome or X</string>
    <string name="help_step_share_description">Choose Dambom in another app’s share menu, confirm the link, and start finding videos.</string>
    <string name="help_step_web_title">3. Browse inside the app</string>
    <string name="help_step_web_description">Open multiple web tabs, play the video on the current page, then tap Detect video.</string>
    <string name="help_step_download_title">4. Manage downloads</string>
    <string name="help_step_download_description">Check queue progress and pause, resume, cancel, or retry each download.</string>
    <string name="help_step_library_title">5. Watch in Library</string>
    <string name="help_step_library_description">When you leave while a completed local video is playing full screen, playback continues in PiP on supported devices. Inline, paused, or missing videos do not enter automatically, and no background playback service is provided.</string>
