    <string name="help_intro">Landa kuphela amavidiyo avulekile, angaphandle kwe- DRM onawo imvume yokuwagcina.</string>
    <string name="help_step_url_title">1. Thola ngekheli lewebhu</string>
    <string name="help_step_url_description">Namathisela ikheli lekhasi levidiyo ku-Home, thola amavidiyo, bese ukhetha okufanele ukulondoloze.</string>
    <string name="help_step_share_title">2. Yabelana kusuka ku- Chrome noma ku- X</string>
    <string name="help_step_share_description">Khetha i- Dambom kwimenyu yokwabelana kwesinye isicelo, uqinisekise isixhumanisi, bese uqala ukuthola amavidiyo.</string>
    <string name="help_step_web_title">3. Sesha ngaphakathi kohlelo</string>
    <string name="help_step_web_description">Vula amathebhu amaningi ewebhu, dlala ividiyo ekhasini lamanje, bese uthinta Thola ividiyo.</string>
    <string name="help_step_download_title">4. Phatha ukulanda</string>
    <string name="help_step_download_description">Hlola inqubekela phambili yomugqa bese yima, qhubeka, khansela, noma zama futhi ukulanda ngakunye.</string>
    <string name="help_step_library_title">5. Buka kuLibrari</string>
    <string name="help_step_library_description">Uma ushiya ngesikhathi ividiyo yendawo egcwele isidlala esikrinini esigcwele, ukudlala kuyaqhubeka ku- PiP kumadivayisi asekelayo. Ividiyo ezihlanganisiwe, eziyekile ukudlala, noma ezingekho azifakiwe ngokuzenzakalayo, futhi akukho nsizakalo yokudlala ngemuva enikezwayo.</string>
    <string name="settings_shared_auto_download">Zilandele ngokuzenzakalelayo izixhumanisi ezabiwe</string>
    <string name="settings_shared_auto_description">Landa kuphela izixhumanisi ezabiwe ngekhwalithi owukhethile. Khetha amavidiyo kuqala uma kutholakala amaningi.</string>
