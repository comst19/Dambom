    <string name="settings_shared_lowest">ഏറ്റവും കുറഞ്ഞ നിലവാരം</string>
    <string name="settings_shared_preferred">ഇഷ്ടപ്പെട്ട മിഴിവ്</string>
    <string name="settings_shared_resolution">ഇഷ്ടപ്പെട്ട മിഴിവ്</string>
    <string name="settings_shared_fallback">ലഭ്യമല്ലെങ്കിൽ, നിങ്ങളുടെ മുൻഗണനയ്‌ക്ക് താഴെയുള്ള ഉയർന്ന റെസല്യൂഷൻ ഉപയോഗിക്കുക, അല്ലെങ്കിൽ എല്ലാം കൂടുതലായിരിക്കുമ്പോൾ ഏറ്റവും താഴ്ന്നത് ഉപയോഗിക്കുക.</string>
