    <string name="help_intro">শুধুমাত্র সর্বজনীন, অ- DRM ভিডিও ডাউনলোড করুন যেগুলি সংরক্ষণ করার আপনার অনুমতি আছে।</string>
    <string name="help_step_url_title">1. ওয়েব ঠিকানা দ্বারা খুঁজুন</string>
    <string name="help_step_url_description">হোমে একটি ভিডিও পৃষ্ঠার ঠিকানা আটকান, ভিডিওগুলি খুঁজুন এবং কী সংরক্ষণ করবেন তা চয়ন করুন৷</string>
    <string name="help_step_share_title">2. Chrome বা X থেকে শেয়ার করুন</string>
    <string name="help_step_share_description">অন্য অ্যাপের শেয়ার মেনুতে Dambom বেছে নিন, লিঙ্কটি নিশ্চিত করুন এবং ভিডিও খোঁজা শুরু করুন।</string>
    <string name="help_step_web_title">৩. অ্যাপের ভিতরে ব্রাউজ করুন</string>
    <string name="help_step_web_description">একাধিক ওয়েব ট্যাব খুলুন, বর্তমান পৃষ্ঠায় ভিডিও চালান, তারপর ভিডিও সনাক্ত করুন আলতো চাপুন।</string>
    <string name="help_step_download_title">4. ডাউনলোড পরিচালনা করুন</string>
    <string name="help_step_download_description">সারির অগ্রগতি পরীক্ষা করুন এবং প্রতিটি ডাউনলোডকে বিরতি, পুনরায় শুরু, বাতিল বা পুনরায় চেষ্টা করুন।</string>
    <string name="help_step_library_title">5. লাইব্রেরিতে দেখুন</string>
    <string name="help_step_library_description">যখন আপনি চলে যান যখন একটি সম্পূর্ণ স্থানীয় ভিডিও পূর্ণ স্ক্রিনে চলছে, সমর্থিত ডিভাইসগুলিতে প্লেব্যাক PiP এ চলতে থাকে। ইনলাইন, বিরতি দেওয়া বা অনুপস্থিত ভিডিওগুলি স্বয়ংক্রিয়ভাবে প্রবেশ করে না এবং কোনও পটভূমি প্লেব্যাক পরিষেবা সরবরাহ করা হয় না।</string>
    <string name="settings_shared_auto_download">শেয়ার করা লিঙ্কগুলি স্বয়ংক্রিয়ভাবে ডাউনলোড করুন</string>
    <string name="settings_shared_auto_description">আপনার নির্বাচিত গুণমানে শুধুমাত্র শেয়ার করা লিঙ্কগুলি ডাউনলোড করুন। অনেকগুলি পাওয়া গেলে প্রথমে ভিডিওগুলি নির্বাচন করুন৷</string>
    <string name="settings_shared_quality">স্বয়ংক্রিয় ডাউনলোড গুণমান</string>
    <string name="settings_shared_highest">সর্বোচ্চ মানের</string>
    <string name="settings_shared_lowest">সর্বনিম্ন মানের</string>
    <string name="settings_shared_preferred">পছন্দের রেজোলিউশন</string>
    <string name="settings_shared_resolution">পছন্দের রেজোলিউশন</string>
    <string name="settings_shared_fallback">অনুপলব্ধ হলে, আপনার পছন্দের নীচে সর্বোচ্চ রেজোলিউশন ব্যবহার করুন, অথবা যখন সব বেশি হয় তখন সর্বনিম্ন রেজোলিউশন ব্যবহার করুন।</string>
