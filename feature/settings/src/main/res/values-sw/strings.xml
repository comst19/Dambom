    <string name="help_intro">Pakua tu video za umma, zisizo za DRM ambazo una ruhusa ya kuhifadhi.</string>
    <string name="help_step_url_title">1. Tafuta kwa anwani ya wavuti</string>
    <string name="help_step_url_description">Bandika anwani ya ukurasa wa video kwenye Nyumbani, tafuta video na uchague cha kuhifadhi.</string>
    <string name="help_step_share_title">2. Shiriki kutoka Chrome au X</string>
    <string name="help_step_share_description">Chagua Dambom katika menyu ya kushiriki ya programu nyingine, thibitisha kiungo, na uanze kutafuta video.</string>
    <string name="help_step_web_title">3. Vinjari ndani ya programu</string>
    <string name="help_step_web_description">Fungua vichupo vingi vya wavuti, cheza video kwenye ukurasa wa sasa, kisha uguse Gundua video.</string>
    <string name="help_step_download_title">4. Dhibiti vipakuliwa</string>
    <string name="help_step_download_description">Angalia maendeleo ya foleni na usitishe, endelea, ghairi au ujaribu tena kila upakuaji.</string>
    <string name="help_step_library_title">5. Tazama kwenye Maktaba</string>
    <string name="help_step_library_description">Unapoondoka huku video iliyokamilika ya ndani inacheza skrini nzima, uchezaji utaendelea katika PiP kwenye vifaa vinavyotumika. Video za ndani, zilizositishwa, au zinazokosekana haziingii kiotomatiki, na hakuna huduma ya kucheza chinichini inayotolewa.</string>
    <string name="settings_shared_auto_download">Pakua viungo vilivyoshirikiwa kiotomatiki</string>
    <string name="settings_shared_auto_description">Pakua viungo vilivyoshirikiwa pekee katika ubora uliochagua. Chagua video kwanza wakati kadhaa zinapatikana.</string>
