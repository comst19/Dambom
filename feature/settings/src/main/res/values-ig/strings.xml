    <string name="help_intro">Naanị budata vidiyo ọha na-abụghị nke DRM nke ị nwere ikike ịchekwa.</string>
    <string name="help_step_url_title">1. Chọta site na adreesị webụ</string>
    <string name="help_step_url_description">Tapawa adreesị ibe vidiyo na Ụlọ, chọta vidiyo, wee họrọ ihe ị ga-echekwa.</string>
    <string name="help_step_share_title">2. Kekọrịta site na Chrome ma ọ bụ X</string>
    <string name="help_step_share_description">Họrọ Dambom na nchịkọta nhọrọ nke ngwa ọzọ, kwado njikọ ahụ, malite ịchọta vidiyo.</string>
    <string name="help_step_web_title">3. Chọgharịa n\'ime ngwa</string>
    <string name="help_step_web_description">Mepee ọtụtụ taabụ webụ, kpọọ vidiyo dị na ibe dị ugbu a, wee pịa Chọpụta vidiyo.</string>
    <string name="help_step_download_title">4. Jikwaa nbudata</string>
    <string name="help_step_download_description">Lelee ọganihu kwụ n\'ahịrị wee kwụsịtụ, malitegharịa, kagbuo, ma ọ bụ megharịa nbudata ọ bụla.</string>
    <string name="help_step_library_title">5. Na-ekiri na Library</string>
    <string name="help_step_library_description">Mgbe ịpụọ ka vidiyo mpaghara emechara na-akpọ n\'ihuenyo zuru oke, ọkpụkpọ na-aga n\'ihu na PiP na ngwaọrụ akwadoro. Vidiyo dị n\'ahịrị, kwụsịtụrụ, ma ọ bụ na-efu efu anaghị abanye na akpaghị aka, ọ nweghịkwa ọrụ ọkpụkpọ ndabere ọ bụla enyere.</string>
    <string name="settings_shared_auto_download">Njikọ ebudatara na-akpaghị aka</string>
    <string name="settings_shared_auto_description">Budata naanị njikọ kekọrịtara na ogo ị họọrọ. Họrọ vidiyo buru ụzọ hụ mgbe achọtara ọtụtụ.</string>
