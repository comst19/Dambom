    <string name="help_intro">הורד רק סרטונים ציבוריים שאינם DRM שיש לך הרשאה לשמור.</string>
    <string name="help_step_url_title">1. מצא לפי כתובת אינטרנט</string>
    <string name="help_step_url_description">הדבק כתובת של דף וידאו בדף הבית, מצא סרטונים ובחר מה לשמור.</string>
    <string name="help_step_share_title">2. שתף מ- Chrome או X</string>
    <string name="help_step_share_description">בחר Dambom בתפריט השיתוף של אפליקציה אחרת, אשר את הקישור והתחל למצוא סרטונים.</string>
    <string name="help_step_web_title">3. דפדף בתוך האפליקציה</string>
    <string name="help_step_web_description">פתחו מספר כרטיסיות אינטרנט, הפעל את הסרטון בדף הנוכחי ולאחר מכן הקש על זיהוי וידאו.</string>
    <string name="help_step_download_title">4. נהל הורדות</string>
    <string name="help_step_download_description">בדוק את התקדמות התור והשהה, המשך, בטל או נסה שוב כל הורדה.</string>
    <string name="help_step_library_title">5. צפו בספרייה</string>
    <string name="help_step_library_description">כאשר אתה עוזב בזמן שסרטון מקומי הושלם מתנגן במסך מלא, ההשמעה ממשיכה ב- PiP במכשירים נתמכים. סרטונים מוטבעים, מושהים או חסרים אינם נכנסים אוטומטית, ולא מסופק שירות השמעה ברקע.</string>
    <string name="settings_shared_auto_download">הורדה אוטומטית של קישורים משותפים</string>
    <string name="settings_shared_auto_description">הורד רק קישורים משותפים באיכות שבחרת. בחר סרטונים תחילה כאשר יימצאו כמה.</string>
