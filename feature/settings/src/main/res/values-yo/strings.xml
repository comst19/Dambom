    <string name="help_intro">Ṣe igbasilẹ awọn fidio ti gbogbo eniyan nikan, ti kii ṣe DRM ti o ni igbanilaaye lati fipamọ.</string>
    <string name="help_step_url_title">1. Wa nipasẹ adirẹsi ayelujara</string>
    <string name="help_step_url_description">Lẹẹmọ adirẹsi oju-iwe fidio kan si Ile, wa awọn fidio, ko si yan kini lati fipamọ.</string>
    <string name="help_step_share_title">2. Pin lati Chrome tabi X</string>
    <string name="help_step_share_description">Yan Dambom ninu akojọ aṣayan ipin app miiran, jẹrisi ọna asopọ, ki o bẹrẹ wiwa awọn fidio.</string>
    <string name="help_step_web_title">3. Kiri inu awọn app</string>
    <string name="help_step_web_description">Ṣii ọpọ awọn taabu wẹẹbu, mu fidio ṣiṣẹ ni oju-iwe lọwọlọwọ, lẹhinna tẹ Wa fidio ni kia kia.</string>
    <string name="help_step_download_title">4. Ṣakoso awọn gbigba lati ayelujara</string>
    <string name="help_step_download_description">Ṣayẹwo ilọsiwaju ti isinyi ati duro, bẹrẹ pada, fagilee, tabi tun gbiyanju igbasilẹ kọọkan.</string>
    <string name="help_step_library_title">5. Wo ni Library</string>
    <string name="help_step_library_description">Nigbati o ba lọ kuro lakoko fidio agbegbe ti o pari ti n ṣiṣẹ ni kikun iboju, ṣiṣiṣẹsẹhin tẹsiwaju ni PiP lori awọn ẹrọ atilẹyin. Opopo, ti daduro, tabi awọn fidio ti o padanu ko wọle laifọwọyi, ko si si iṣẹ ṣiṣiṣẹsẹhin abẹlẹ ti a pese.</string>
    <string name="settings_shared_auto_download">Laifọwọyi-gba lati ayelujara pín ìjápọ</string>
    <string name="settings_shared_auto_description">Ṣe igbasilẹ awọn ọna asopọ pinpin nikan ni didara ti o yan. Yan awọn fidio ni akọkọ nigbati ọpọlọpọ ba ri.</string>
